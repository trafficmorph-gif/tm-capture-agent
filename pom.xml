<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Deliberately standalone — no Spring Boot parent, no inheritance
        from the main app's pom. The whole point of this module is to
        be embeddable into arbitrary consumer apps without dragging in
        Spring / Jackson / Hibernate / etc. through transitive deps.

        Built independently:
            cd capture-agent
            mvn package

        Consumers add the produced jar to their build:
            <dependency>
              <groupId>com.trafficmorph</groupId>
              <artifactId>tm-capture-agent</artifactId>
              <version>0.1.0-SNAPSHOT</version>
            </dependency>
    -->

    <groupId>com.trafficmorph</groupId>
    <artifactId>tm-capture-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>TrafficMorph Capture Agent</name>
    <description>
        Low-overhead, non-blocking library for emitting JSONL traffic
        captures consumable by TrafficMorph's capture-import flow.
        Designed to live on hot paths: log() returns in O(100ns),
        I/O happens on a separate daemon writer thread, the producer
        thread never blocks on disk.
    </description>

    <properties>
        <!--
            Java 17 baseline (NOT 21 like the main app) so the agent
            can be embedded into a wider range of consumer services.
            17 still gives us records, pattern matching, sealed types,
            and Text Blocks for the internal API.
        -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!--
            Servlet API is provided / optional: the servlet-filter
            convenience class is only loaded if the consumer has a
            Servlet 5+ (jakarta) container on the classpath. Plain
            (non-servlet) consumers don't need it.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ── Test-scope only ─────────────────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            Mockito is used ONLY by the servlet-filter test suite —
            implementing the full HttpServletRequest interface by hand
            (50+ methods, mostly abstract) for each test scenario is
            unmaintainable. The dep is scoped to tests so it never
            reaches consumers; the production jar still has zero
            transitive deps beyond the provided/optional servlet-api.

            We force the SUBCLASS mock maker via
            src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker
            because Mockito 5's default inline maker needs a JVM agent
            self-attach which fails on some Java 21+ configurations
            (recent OpenJDK builds tighten dynamic-agent loading by
            default). Our tests only mock interfaces, so the subclass
            maker's "no final classes" limitation never applies.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            Embedded Jetty 12 (jakarta.servlet 6 line) used by
            CaptureServletFilterIntegrationTest to validate the
            filter end-to-end against a real servlet container —
            the mock-based suite covers spec-contract correctness
            in isolation, but it cannot replicate container-driven
            request lifecycle (real getInputStream backed by a
            socket, real header parsing, real chain dispatch).
            One pass through a real container catches regressions
            mocks structurally cannot see. Test scope keeps this
            out of the production jar.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>12.0.16</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>
</project>
