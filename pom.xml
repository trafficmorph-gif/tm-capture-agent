<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Deliberately standalone — no Spring Boot parent, no inheritance
        from the main app's pom. The whole point of this module is to
        be embeddable into arbitrary consumer apps without dragging in
        Spring / Jackson / Hibernate / etc. through transitive deps.

        Built independently:
            cd capture-agent
            mvn package

        Consumers add the released jar to their build (Maven Central):
            <dependency>
              <groupId>com.trafficmorph</groupId>
              <artifactId>tm-capture-agent</artifactId>
              <version>0.1.1</version>
            </dependency>

        Releases:
            scripts/release-tm-capture-agent.sh X.Y.Z
        bumps the version here, commits, tags `tm-capture-agent-vX.Y.Z`,
        and triggers the Maven Central publish workflow. See the
        `release` profile below for the deploy-time plumbing
        (sources jar, javadoc jar, GPG signing, central-publishing).
    -->

    <groupId>com.trafficmorph</groupId>
    <artifactId>tm-capture-agent</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>

    <name>TrafficMorph Capture Agent</name>
    <description>
        Low-overhead, non-blocking library for emitting JSONL traffic
        captures consumable by TrafficMorph's capture-import flow.
        Designed to live on hot paths: log() returns in O(100ns),
        I/O happens on a separate daemon writer thread, the producer
        thread never blocks on disk.
    </description>
    <url>https://github.com/trafficmorph-gif/tm-capture-agent</url>
    <inceptionYear>2026</inceptionYear>

    <!--
        Apache 2.0 matches the rest of the public SDK family
        (sdk-go, sdk-python, sdk-mcp, cli). The license file lives
        at capture-agent/LICENSE so it travels into the mirror
        repo on every release.
    -->
    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>olexandrvorona</id>
            <name>Alex Vorona</name>
            <email>olexandrvorona@gmail.com</email>
            <organization>TrafficMorph</organization>
            <organizationUrl>https://trafficmorph.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <!--
            SCM points at the standalone mirror repo, NOT the
            monorepo: the mirror is what consumers see when they
            click through "View source" on Maven Central. The
            monorepo is private; the mirror is the public face.
        -->
        <connection>scm:git:https://github.com/trafficmorph-gif/tm-capture-agent.git</connection>
        <developerConnection>scm:git:git@github.com:trafficmorph-gif/tm-capture-agent.git</developerConnection>
        <url>https://github.com/trafficmorph-gif/tm-capture-agent</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!--
            Java 17 baseline (NOT 21 like the main app) so the agent
            can be embedded into a wider range of consumer services.
            17 still gives us records, pattern matching, sealed types,
            and Text Blocks for the internal API.
        -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.10.2</junit.version>
    </properties>

    <dependencies>
        <!--
            Servlet API is provided / optional: the servlet-filter
            convenience class is only loaded if the consumer has a
            Servlet 5+ (jakarta) container on the classpath. Plain
            (non-servlet) consumers don't need it.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ── Test-scope only ─────────────────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            Mockito is used ONLY by the servlet-filter test suite —
            implementing the full HttpServletRequest interface by hand
            (50+ methods, mostly abstract) for each test scenario is
            unmaintainable. The dep is scoped to tests so it never
            reaches consumers; the production jar still has zero
            transitive deps beyond the provided/optional servlet-api.

            We force the SUBCLASS mock maker via
            src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker
            because Mockito 5's default inline maker needs a JVM agent
            self-attach which fails on some Java 21+ configurations
            (recent OpenJDK builds tighten dynamic-agent loading by
            default). Our tests only mock interfaces, so the subclass
            maker's "no final classes" limitation never applies.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.11.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            Embedded Jetty 12 (jakarta.servlet 6 line) used by
            CaptureServletFilterIntegrationTest to validate the
            filter end-to-end against a real servlet container —
            the mock-based suite covers spec-contract correctness
            in isolation, but it cannot replicate container-driven
            request lifecycle (real getInputStream backed by a
            socket, real header parsing, real chain dispatch).
            One pass through a real container catches regressions
            mocks structurally cannot see. Test scope keeps this
            out of the production jar.
        -->
        <dependency>
            <groupId>org.eclipse.jetty.ee10</groupId>
            <artifactId>jetty-ee10-servlet</artifactId>
            <version>12.0.16</version>
            <scope>test</scope>
        </dependency>
        <!--
            JMH micro-benchmarking for hot-path latency and
            sustained throughput. Test scope: benchmarks live
            under src/test/java/com/trafficmorph/capture/bench/
            and are NOT invoked by the JUnit Surefire run — they
            stay inert during `mvn test`. Run via:
              mvn -Pbench test-compile exec:exec
            (see the bench profile below — uses exec:exec, NOT
            exec:java, because JMH's worker JVMs need to fork
            with a fresh classpath which exec:java can't provide).
            The annotation-processor artifact generates per-
            benchmark stub classes during test-compile.
        -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>1.37</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <!--
                        Explicit annotation-processor path for the
                        test compile only. JMH's generator-annprocess
                        artifact must be on the processor path during
                        test-compile so the @Benchmark methods get
                        their per-class stubs generated under
                        target/generated-test-sources. Maven's auto-
                        discovery of processors on the classpath is
                        unreliable for test scope under newer JDK +
                        compiler-plugin combinations; declaring the
                        path explicitly is the documented JMH pattern.
                        Production compile is untouched — no
                        processor runs, no overhead, no contamination
                        of the deployed jar.
                    -->
                    <execution>
                        <id>default-testCompile</id>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>1.37</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activate with `mvn -Pbench test-compile exec:exec`.
            Runs the JMH suite via BenchmarkRunner.main, with the
            full test classpath (test-scope deps + generated JMH
            stubs in target/generated-test-sources). The plugin
            binding below uses exec:exec specifically — see the
            comment on the plugin block for why exec:java doesn't
            work here. Surefire stays out of the picture —
            benchmarks are NOT JUnit tests and shouldn't be
            invoked by `mvn test`.
        -->
        <profile>
            <id>bench</id>
            <!--
                Default value for the benchmark filter regex —
                BenchmarkRunner reads it via System.getProperty("bench").
                JMH's include() is a case-sensitive regex and the
                benchmark method names use lowercase suffixes
                (..._latency, ..._throughput_*), so filter examples
                must match the method-name case. Override on the
                command line:
                  -Dbench=latency           — only the latency methods
                  -Dbench=throughput        — only the throughput sweep
                  -Dbench=logCheap_latency  — one specific method
                Without the explicit property forwarding in
                <arguments> below, a Maven-side -Dbench=... wouldn't
                reach the spawned JVM (exec:exec doesn't auto-forward
                Maven's own system properties to the new process).
            -->
            <properties>
                <bench>CaptureLoggerBenchmark</bench>
            </properties>
            <build>
                <plugins>
                    <!--
                        exec:exec (NOT exec:java) so we spawn a fresh
                        JVM whose classpath is built explicitly from
                        Maven's resolved test classpath. exec:java
                        runs in Maven's own JVM, and JMH's forked
                        worker JVMs then can't see the JMH /
                        benchmark classes because they don't inherit
                        that classpath. With exec:exec we control
                        the command line, and the same classpath is
                        passed onward to JMH's own forks via
                        java.class.path (the BenchmarkRunner picks
                        it up and threads it into JMH's jvmArgs).
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <!--
                                    Forward the benchmark-filter
                                    property explicitly. ${bench}
                                    resolves from the profile's
                                    <properties> default OR the
                                    user's -Dbench=... override.
                                -->
                                <argument>-Dbench=${bench}</argument>
                                <argument>com.trafficmorph.capture.bench.BenchmarkRunner</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Maven Central publishing profile. Activated only by the
            release workflow (`mvn -P release deploy`), never during
            regular `mvn test` / `mvn install`. Three concerns:

              1. Build sources + javadoc jars — Central rejects
                 releases without them.
              2. GPG-sign every artifact (pom, jar, sources, javadoc).
                 Central rejects unsigned uploads.
              3. Upload via the new Central Publishing plugin (the
                 successor to the legacy Sonatype OSSRH staging
                 dance — single-step "deploy then auto-release").

            One-time setup for whoever runs the first release:
              1. Sonatype Central Portal account, namespace
                 `com.trafficmorph` claimed (proven via DNS TXT on
                 trafficmorph.com OR via GitHub-handle verification).
              2. GPG key generated, public key published to
                 keys.openpgp.org or similar, fingerprint registered
                 in the Central Portal namespace settings.
              3. GitHub repo secrets:
                   CENTRAL_TOKEN_USERNAME, CENTRAL_TOKEN_PASSWORD
                     User Token from the Portal (NOT the password).
                   MAVEN_GPG_PRIVATE_KEY
                     Armored export of the private key.
                   MAVEN_GPG_PASSPHRASE
                     Passphrase for the key.
                 These get loaded into the publish workflow via
                 `actions/setup-java` + the plugin's env-var pickup.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Sources jar — `mvn package` already runs
                         this when the profile is active. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Javadoc jar. -doclint:none silences errors
                         from the existing javadoc style — Central
                         only needs the jar to exist, not perfect
                         doclint compliance. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.7.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <source>17</source>
                            <quiet>true</quiet>
                            <!-- Don't fail the build on missing
                                 javadoc tags — Central just needs
                                 the jar to exist, ours is rich
                                 enough that one missing @param
                                 shouldn't block a publish. -->
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                        </configuration>
                    </plugin>

                    <!-- GPG signing. The plugin reads the key from
                         GPG's local keyring; the workflow imports
                         it from MAVEN_GPG_PRIVATE_KEY before mvn
                         runs. The passphrase comes from the
                         GPG_PASSPHRASE env (configured below). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- Non-interactive mode for CI;
                                         the passphrase comes from
                                         env, not stdin. -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sonatype Central Portal publisher. Uploads
                         the staged bundle in a single POST and
                         auto-releases. autoPublish was false on the
                         first release (0.1.0) as a sanity gate —
                         we manually clicked Publish in the Portal
                         to confirm the artifact looked right end-
                         to-end. Now that the pipeline is proven,
                         flipping to true makes subsequent releases
                         hands-off. If you ever need to inspect a
                         bundle before it goes live (e.g. when
                         changing the pom shape, swapping GPG keys),
                         flip back to false for one release. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.6.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
